#!/usr/bin/env envstack
include: [default]
all: &all
  PROJECT_ROOT: ${PROJECT_ROOT:=${ROOT}/{project}}
  ASSET_ROOT: ${ASSET_ROOT:=${PROJECT_ROOT}/assets/{asset}}
  STEP_ROOT: ${STEP_ROOT:=${ASSET_ROOT}/{step}}
  FILEPATH: ${FILEPATH:=${STEP_ROOT}/{asset}_{task}_v{version:03d}.{ext}}
darwin:
  <<: *all
  ROOT: ${ROOT:=/Volumes/projects}
linux:
  <<: *all
  ROOT: ${ROOT:=/mnt/projects}
windows:
  <<: *all
  ROOT: ${ROOT:=P:/projects}
