#!/usr/bin/env envstack
include: [default]
all: &all
  PROJECT_ROOT: ${ROOT}/{project}
  ASSET_ROOT: ${PROJECT_ROOT}/assets/{asset}
  STEP_ROOT: ${ASSET_ROOT}/{step}
  FILEPATH: ${STEP_ROOT}/{asset}_{task}_v{version:03d}.{ext}
darwin:
  <<: *all
  ROOT: /Volumes/projects
linux:
  <<: *all
  ROOT: /mnt/projects
windows:
  <<: *all
  ROOT: D:/projects
