#!/usr/bin/env envstack
include: [default]
all: &all
  SHOW: bigbuckbunny
  SHOW_ROOT: ${SHOW_ROOT:=${ROOT}/bigbuckbunny}
  STEP_ROOT: ${STEP_ROOT:=${SHOT_ROOT}/tasks/{step}}
  FILEPATH: ${FILEPATH:=${STEP_ROOT}/{shot}_{task}_{descriptor}_v{version:03d}.{frame:04d}.{ext}}
darwin:
  <<: *all
linux:
  <<: *all
windows:
  <<: *all
