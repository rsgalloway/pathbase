#!/usr/bin/env envstack
include: [default]
all: &all
  SERVICE_ROOT: ${SERVICE_ROOT:=${ROOT}/{environment}/{service}}
  DATE_ROOT: ${DATE_ROOT:=${SERVICE_ROOT}/{date}}
  FILEPATH: ${FILEPATH:=${DATE_ROOT}/{level}.log}
darwin:
  <<: *all
  ROOT: ${ROOT:=/var/log}
linux:
  <<: *all
  ROOT: ${ROOT:=/var/log}
windows:
  <<: *all
  ROOT: ${ROOT:=C:/logs}
