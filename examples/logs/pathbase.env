#!/usr/bin/env envstack
include: [default]
all: &all
  SERVICE_ROOT: ${ROOT}/{environment}/{service}
  DATE_ROOT: ${SERVICE_ROOT}/{date}
  FILEPATH: ${DATE_ROOT}/{level|debug|info|warning|error|critical}.log
darwin:
  <<: *all
  ROOT: /var/log
linux:
  <<: *all
  ROOT: /var/log
windows:
  <<: *all
  ROOT: C:/logs
