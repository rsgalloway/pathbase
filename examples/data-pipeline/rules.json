{
  "description": "Token rules for the data-pipeline example; see docs/api.md#token-rules",
  "rules": {
    "dataset": "^[a-z][a-z0-9_]*$",
    "date": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "partition": "^[a-z][a-z0-9_]*=[A-Za-z0-9_.-]+$",
    "ext": "^(parquet|csv|json|jsonl|avro|orc)$"
  },
  "templates": {
    "FILEPATH": {
      "rules": {
        "index": "^[0-9]{4}$"
      }
    }
  }
}
