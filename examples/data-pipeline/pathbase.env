#!/usr/bin/env envstack
include: [default]
all: &all
  DATASET_ROOT: ${ROOT}/{dataset}
  DATE_ROOT: ${DATASET_ROOT}/{date}
  PARTITION_ROOT: ${DATE_ROOT}/{partition}
  FILEPATH: ${PARTITION_ROOT}/part-{index:04d}.{ext}
darwin:
  <<: *all
  ROOT: /Volumes/data
linux:
  <<: *all
  ROOT: /mnt/data
windows:
  <<: *all
  ROOT: D:/data
