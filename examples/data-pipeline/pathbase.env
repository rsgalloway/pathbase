#!/usr/bin/env envstack
include: [default]
all: &all
  DATASET_ROOT: ${DATASET_ROOT:=${ROOT}/{dataset}}
  DATE_ROOT: ${DATE_ROOT:=${DATASET_ROOT}/{date}}
  PARTITION_ROOT: ${PARTITION_ROOT:=${DATE_ROOT}/{partition}}
  FILEPATH: ${FILEPATH:=${PARTITION_ROOT}/part-{index:04d}.{ext}}
darwin:
  <<: *all
  ROOT: ${ROOT:=/Volumes/data}
linux:
  <<: *all
  ROOT: ${ROOT:=/mnt/data}
windows:
  <<: *all
  ROOT: ${ROOT:=D:/data}
