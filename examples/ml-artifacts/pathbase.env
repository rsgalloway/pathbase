#!/usr/bin/env envstack
include: [default]
all: &all
  PROJECT_ROOT: ${ROOT}/{project}
  EXPERIMENT_ROOT: ${PROJECT_ROOT}/{experiment}
  RUN_ROOT: ${EXPERIMENT_ROOT}/{run_id}
  FILEPATH: ${RUN_ROOT}/{artifact}.{ext}
darwin:
  <<: *all
  ROOT: /Volumes/ml
linux:
  <<: *all
  ROOT: /mnt/ml
windows:
  <<: *all
  ROOT: D:/ml
