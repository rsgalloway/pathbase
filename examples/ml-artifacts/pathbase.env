#!/usr/bin/env envstack
include: [default]
all: &all
  PROJECT_ROOT: ${PROJECT_ROOT:=${ROOT}/{project}}
  EXPERIMENT_ROOT: ${EXPERIMENT_ROOT:=${PROJECT_ROOT}/{experiment}}
  RUN_ROOT: ${RUN_ROOT:=${EXPERIMENT_ROOT}/{run_id}}
  FILEPATH: ${FILEPATH:=${RUN_ROOT}/{artifact}.{ext}}
darwin:
  <<: *all
  ROOT: ${ROOT:=/Volumes/ml}
linux:
  <<: *all
  ROOT: ${ROOT:=/mnt/ml}
windows:
  <<: *all
  ROOT: ${ROOT:=D:/ml}
