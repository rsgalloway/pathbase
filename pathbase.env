#!/usr/bin/env envstack
include: [default]
all: &all
  PROJECT_ROOT: ${ROOT}/{project}
  GROUP_ROOT: ${PROJECT_ROOT}/{group}
  ITEM_ROOT: ${GROUP_ROOT}/{item}
  FILEPATH: ${ITEM_ROOT}/{name}_v{version:03d}.{ext}
darwin:
  <<: *all
  ROOT: /Volumes/projects
linux:
  <<: *all
  ROOT: /mnt/projects
windows:
  <<: *all
  ROOT: D:/projects
